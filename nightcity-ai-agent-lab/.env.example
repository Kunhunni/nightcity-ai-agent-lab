# ============================================================================
# NightCity AI Agent Lab - LLM & Security Posture Configuration
# ============================================================================
# Supported Providers: nvidia | groq | openrouter | alibaba
LLM_PROVIDER=nvidia

# Paste your free NVIDIA Build API key (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-api-key-here

# Exact Qwen model used in the course lab
LLM_MODEL=qwen/qwen2.5-7b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Security Posture: vulnerable (default lab behavior) | hardened (AI Engineer mitigations)
SECURITY_POSTURE=vulnerable
